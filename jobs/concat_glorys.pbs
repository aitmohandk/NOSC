#!/bin/csh
#PBS -N glorys_concat
#PBS -q omp
#PBS -l select=1:ncpus=4:mem=16g
#PBS -l walltime=02:00:00
#
# Merge the per-year files produced by prepare_glorys.pbs into the two
# consolidated files the OSSE configs expect:
#     glorys_gs_surface_2010-2020.nc
#     glorys_gs_multidepth_2010-2020.nc
#
# The actual work lives in code/download_data_/concat_glorys.py. It is a real
# .py file on purpose: an inline `python -c "...multi-line..."` breaks under csh
# with `Unmatched "`, because csh cannot carry a double-quoted argument across
# lines. Calling a file passes args cleanly via argv.
#
# Run AFTER the whole prepare_glorys.pbs array has finished. To chain it on the
# array (quote the value: the array id contains [] which csh would glob):
#     set A = `qsub jobs/prepare_glorys.pbs`
#     qsub -W "depend=afterokarray:$A" jobs/concat_glorys.pbs

source /usr/share/Modules/init/csh
module load singularity

set BY_YEAR = $SCRATCH/nosc/data/by_year
set OUT     = $DATAWORK/nosc/data          # durable, non purgé
set LABEL   = 2010-2020

singularity exec --bind $DATAWORK,$SCRATCH \
  $DATAWORK/containers/nosc-2026-09.sif \
  python -u $DATAWORK/NOSC/code/download_data_/concat_glorys.py $BY_YEAR $OUT $LABEL
